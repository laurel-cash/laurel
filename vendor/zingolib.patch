+
+impl SpendPoolScope {
+    /// Sets the pool for proposals built on this thread while the scope lives.
+    pub fn only(pool: Option<PoolType>) -> Self {
+        let previous = SPEND_POOL.with(|cell| cell.replace(pool));
+        Self(previous)
+    }
+}
+
+impl Drop for SpendPoolScope {
+    fn drop(&mut self) {
+        SPEND_POOL.with(|cell| cell.set(self.0));
+    }
+}
+
+fn spend_pool_allows(pool: PoolType) -> bool {
+    SPEND_POOL.with(|cell| cell.get().is_none_or(|only| only == pool))
