+    net.chain.write().await.mine_empty_blocks(1);
+    fund(&net, vec![(&sender_ua, 100_000, None)], 1).await;
+    sender.sync_and_await().await.unwrap();
+    let mined = sender
+        .wallet()
+        .read()
+        .await
+        .wallet_transactions
+        .values()
+        .find(|t| matches!(t.status(), ConfirmationStatus::Confirmed(_)))
+        .unwrap()
+        .txid();
+
+    let sent = from_inputs::quick_send(
