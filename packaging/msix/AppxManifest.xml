<?xml version="1.0" encoding="utf-8"?>
<!--
  Laurel's MSIX package for the Microsoft Store, filled in by scripts/store_msix.mjs:
  {NAME}, {PUBLISHER}, {PUBLISHER_NAME} and {DISPLAY_NAME} are the identity Partner Center
  reserves for the app (packaging/msix/identity.json); {VERSION} is package.json's, with a
  fourth 0. The Store signs the package.
  A full-trust desktop app (Tauri, WebView2). Its files live where Windows keeps a packaged
  app's data, and leave with it when it's uninstalled, as on a phone: the recovery phrase is
  what brings a wallet back (docs/WINDOWS-STORE.md).
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity Name="{NAME}" Publisher="{PUBLISHER}" Version="{VERSION}" ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>{DISPLAY_NAME}</DisplayName>
    <PublisherDisplayName>{PUBLISHER_NAME}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Laurel" Executable="laurel.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="{DISPLAY_NAME}"
        Description="A private Zcash wallet"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <!-- scanning a payment request's QR code -->
    <DeviceCapability Name="webcam" />
  </Capabilities>
</Package>
