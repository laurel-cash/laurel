{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Laurel",
	"version": "../package.json",
	"identifier": "com.rptxsoftware.wallet",
	"build": {
		"beforeDevCommand": "npm run dev",
		"devUrl": "http://127.0.0.1:1420",
		"beforeBuildCommand": "npm run build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"label": "main",
				"create": false,
				"title": "Laurel",
				"width": 1100,
				"height": 720,
				"minWidth": 900,
				"minHeight": 600,
				"center": true,
				"decorations": false,
				"shadow": true
			}
		],
		"security": {
			"csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' mediastream: blob:; worker-src blob:; connect-src ipc: http://ipc.localhost"
		}
	},
	"bundle": {
		"active": true,
		"targets": "all",
		"icon": [
			"icons/32x32.png",
			"icons/128x128.png",
			"icons/128x128@2x.png",
			"icons/icon.icns",
			"icons/icon.ico"
		]
	}
}
